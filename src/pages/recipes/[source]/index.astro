---
import Base from '../../../layouts/Base.astro';
import SourceRecipeBrowser from '../../../components/SourceRecipeBrowser.astro';
import { render } from 'astro:content';
import { getRecipes, catSlug, pageOf, displayName, compareCitations, getSourceEntry } from '../../../lib/recipes.ts';
import { sourceTexts } from '../../../data/sources/index.ts';

export async function getStaticPaths() {
  const recipes = await getRecipes();
  const byWork = new Map<string, typeof recipes>();
  for (const r of recipes) {
    const w = pageOf(r.data);
    if (!byWork.has(w)) byWork.set(w, []);
    byWork.get(w)!.push(r);
  }
  return [...byWork.entries()].map(([work, list]) => ({
    params: { source: catSlug(work) },
    props: { work, list: list.sort((a, b) => compareCitations(a.data, b.data)) },
  }));
}

const { work, list } = Astro.props;
const title = displayName(work);
const sourceEntry = await getSourceEntry(work);
const period = sourceEntry?.data.period;
// Some source entries carry only a date (no blurb body); render the blurb
// column only when there's actual prose, so date-only entries don't leave an
// empty column.
const Blurb = sourceEntry?.body?.trim() ? (await render(sourceEntry)).Content : undefined;
const em = (s?: string) => (s ?? '').replace(/\*([^*]+)\*/g, '<em>$1</em>');
const escAttr = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Editorial additions and uncertainty notes are written in [square brackets].
// Inline they swamp the prose, so render each as a superscript marker holding
// its note — shown on hover, and on keyboard focus or tap via :focus-within.
// Scanned rather than matched by regex: notes nest to arbitrary depth, since a
// note may gloss a bracketed word of its own. Unbalanced brackets are left
// alone rather than silently swallowing the rest of the paragraph.
function noteify(s: string) {
  let out = '';
  let i = 0;
  while (i < s.length) {
    if (s[i] !== '[') { out += s[i++]; continue; }
    let depth = 0;
    let j = i;
    for (; j < s.length; j++) {
      if (s[j] === '[') depth++;
      else if (s[j] === ']' && --depth === 0) break;
    }
    if (j >= s.length) { out += s[i++]; continue; } // unbalanced: leave as-is
    out +=
      '<span class="ednote" tabindex="0"><sup>◦</sup>' +
      `<span class="ednote-body">${noteify(s.slice(i + 1, j))}</span></span>`;
    i = j + 1;
  }
  return out;
}

// Anuṣṭubh is printed as two half-lines per verse, closed by ॥ N ॥. Split on
// those markers so the page shows the verse structure instead of one long
// paragraph. Returns null for sources with no verse markers (e.g. Vinidarius),
// which fall back to running text.
const DEVA = '०१२३४५६७८९';
const toArabic = (n: string) =>
  Number([...n].map((c) => (DEVA.indexOf(c) >= 0 ? String(DEVA.indexOf(c)) : c)).join(''));
function splitVerses(latin: string, blockStart: number, blockEnd: number) {
  if (!latin.includes('॥')) return null;
  const out: { num: number | null; lines: string[] }[] = [];
  const re = /॥\s*([\d०-९]+)\s*॥/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(latin)) !== null) {
    const body = latin.slice(last, m.index).trim();
    last = re.lastIndex;
    // Printed verse numbers are abbreviated to their last digits; restore the
    // century from the block's own first verse.
    const raw = toArabic(m[1]);
    let num: number | null = raw;
    if (raw < 100) {
      num = Math.floor(blockStart / 100) * 100 + raw;
      if (num < blockStart) num += 100;
    }
    // A marker outside the block's own span isn't a verse number — the
    // colophon closes with the adhyāya number (॥ १३ ॥). Leave it unlabelled.
    if (num !== null && (num < blockStart || num > blockEnd)) num = null;
    const lines = body.split('।').map((l) => l.trim()).filter(Boolean);
    if (lines.length) out.push({ num, lines });
  }
  const tail = latin.slice(last).trim();
  if (tail) out.push({ num: null, lines: tail.split('।').map((l) => l.trim()).filter(Boolean) });
  return out.length ? out : null;
}

// The complete surviving text (independent of which entries have become
// cooked recipe pages), linked through to whichever recipes it covers.
//
// Matching is by overlapping verse range, not by string equality: the text's
// blocks are sense units and often straddle verse boundaries ("1385cd–1386ab"),
// so they rarely equal a recipe's own citation. Overlap also means one block
// can list several recipes — the four pork cakkalikās all cite 1436–1441.
const fullText = sourceTexts[work];
const verseSpan = (s: string): [number, number] | null => {
  const ns = (s.match(/\d{3,}/g) ?? []).map(Number);
  if (!ns.length) return null;
  return [ns[0], ns[ns.length - 1]];
};
const spans = list
  .map((r) => ({ recipe: r, span: verseSpan(r.data.source) }))
  .filter((x): x is { recipe: typeof x.recipe; span: [number, number] } => x.span !== null);
const textEntries = (fullText ?? []).map((entry) => {
  const span = verseSpan(entry.ref);
  return {
    ...entry,
    recipes: span
      ? spans.filter((x) => x.span[0] <= span[1] && span[0] <= x.span[1]).map((x) => x.recipe)
      : [],
    verses: splitVerses(entry.latin, span ? span[0] : 0, span ? span[1] : Infinity),
  };
});
---
<Base title={title} description={`Recipes from ${title}.`} wide>
  <p class="crumb"><a href="/recipes/">Recipes</a> › {title}</p>
  <h1>{title}</h1>
  <p class="meta">
    {period && <span>{period}</span>}
    {period && <span class="dot">·</span>}
    <span>{list.length} recipe{list.length === 1 ? '' : 's'}</span>
  </p>

  {Blurb ? (
    <div class="source-grid">
      <div class="blurb"><Blurb /></div>
      <SourceRecipeBrowser list={list} work={work} />
    </div>
  ) : (
    <SourceRecipeBrowser list={list} work={work} />
  )}

  {textEntries.length > 0 && (
    <details class="full-text">
      <summary>Show full text ({textEntries.length} entries)</summary>
      <div class="text-rows">
        {textEntries.map((entry) => (
          <div class="text-row">
            <span class="ref">
              {entry.recipes.length > 0
                ? entry.recipes.map((r, i) => (
                    <Fragment>
                      {i > 0 && <span class="ref-sep">·</span>}
                      <a href={`/recipes/${catSlug(work)}/${r.id}/`}>
                        {i === 0
                          ? entry.ref
                          : <Fragment set:html={em(r.data.title)} />}
                      </a>
                    </Fragment>
                  ))
                : entry.ref}
            </span>
            {entry.verses
              ? <div class="verses">
                  {entry.verses.map((v) => (
                    <div class="verse">
                      <span class="vnum">{v.num ?? ''}</span>
                      <span class="vlines">
                        {v.lines.map((l, i) => (
                          <span class="vline" set:html={`<em>${em(l)}</em>${i < v.lines.length - 1 ? ' ।' : ' ॥'}`}></span>
                        ))}
                      </span>
                    </div>
                  ))}
                </div>
              : <p class="latin" set:html={`<em>${em(entry.latin)}</em>`}></p>}
            {entry.english
              ? <p class="english" set:html={noteify(em(entry.english))}></p>
              : <p class="english untranslated">—</p>}
          </div>
        ))}
      </div>
    </details>
  )}
</Base>


<style>
  .crumb { font-family: var(--font-sans); font-size: 0.85rem; margin: 0 0 0.6rem; }
  .meta {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0.2rem 0 2rem;
  }
  .meta .dot { margin: 0 0.4rem; }

  .source-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .blurb { font-size: 1.05rem; line-height: 1.65; }
  .blurb :global(p) { margin: 0 0 1rem; }
  .blurb :global(p:last-child) { margin-bottom: 0; }

  @media (max-width: 780px) {
    .source-grid { grid-template-columns: 1fr; gap: 2rem; }
  }

  .full-text { margin-top: 3rem; }
  .full-text summary {
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    padding: 0.6rem 0;
    border-top: 1px solid var(--rule);
  }
  .full-text summary:hover { color: var(--accent); }
  .full-text[open] summary { border-bottom: 1px solid var(--rule); margin-bottom: 1.4rem; }

  .text-rows { display: flex; flex-direction: column; gap: 1.6rem; }
  .text-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr 1fr;
    gap: 1.5rem;
    align-items: baseline;
  }
  .text-row .ref {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .text-row .ref a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--accent); }
  .text-row .ref a:hover { color: var(--accent-hover); border-color: var(--accent-hover); }
  .text-row p { margin: 0; font-size: 0.95rem; line-height: 1.55; }
  .text-row .untranslated { color: var(--muted); }

  /* Verse layout: number in a hanging margin, half-lines stacked as printed. */
  .verses { display: flex; flex-direction: column; gap: 0.5rem; }
  .verse { display: grid; grid-template-columns: 2.6rem 1fr; align-items: baseline; }
  .vnum {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.15em;
  }
  .vlines { display: flex; flex-direction: column; }
  .vline { font-size: 0.95rem; line-height: 1.7; text-indent: 0; }
  .vline + .vline { padding-left: 1.1rem; }

  /* Editorial notes: a marker that reveals its note on hover or focus.
     These spans are injected with set:html, so they never carry Astro's
     scoping attribute — the selectors have to be :global to reach them. */
  .text-row :global(.ednote) {
    cursor: help;
    color: var(--accent);
  }
  .text-row :global(.ednote > sup) { font-size: 0.7em; line-height: 0; }
  /* The bubble is positioned against the paragraph, not the marker, so it can
     never run off the edge of a narrow screen — a marker-anchored tooltip
     would, and CSS has no way to flip it back. It opens just under the
     paragraph, spanning its width. */
  .text-row .english { position: relative; }
  .text-row :global(.ednote-body) {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 0.35rem);
    z-index: 5;
    display: none;
    padding: 0.5rem 0.7rem;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--rule);
    border-radius: 3px;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.14);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.45;
    text-indent: 0;
    white-space: normal;
  }
  .text-row :global(.ednote:hover > .ednote-body),
  .text-row :global(.ednote:focus > .ednote-body),
  .text-row :global(.ednote:focus-within > .ednote-body) { display: block; }
  .text-row :global(.ednote:focus) { outline: 1px dotted var(--accent); outline-offset: 2px; }
  /* A nested note lives inside an open bubble, which is itself positioned —
     anchor the inner one to it rather than to the paragraph. */
  .text-row :global(.ednote-body) { position: absolute; }
  .text-row :global(.ednote-body .ednote-body) { top: calc(100% + 0.3rem); }

  @media (max-width: 700px) {
    .text-row { grid-template-columns: 1fr; gap: 0.4rem; }
    .text-row .ref { order: -1; }
    .verse { grid-template-columns: 2.2rem 1fr; }
    .vline + .vline { padding-left: 0.7rem; }
  }
</style>
